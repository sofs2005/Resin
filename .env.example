RESIN_ADMIN_TOKEN=change-me-admin-token
# Set RESIN_PROXY_TOKEN= to disable proxy authentication.
RESIN_PROXY_TOKEN=change-me-proxy-token
RESIN_PORT=2260

# --- Persistence modes (memory-first, see DESIGN.md §持久化模式（memory-first）) ---
# Write topology snapshots (nodes/leases) back to cache.db.
#   off (default): cache.db is opened and read at bootstrap only, never written;
#                  the cache flush worker does not start. Steady-state writes ≈ 0.
#   on:            first-phase behaviour (dirty sets + periodic flush to cache.db).
# RESIN_CACHE_PERSIST=off
# Widen cache persistence to the volatile tables (nodes_dynamic, node_latency).
#   off (default): cache.db only carries the static set (static nodes,
#                  subscription-node bindings, leases). Probe results and latency
#                  samples stay in memory — they are recomputed within one probe
#                  interval, and persisting them cost ~93MB per 5 minutes on a
#                  47k-node pool.
#   on:            also write nodes_dynamic / node_latency (debug only).
# Only meaningful when RESIN_CACHE_PERSIST=on.
# RESIN_CACHE_PERSIST_VOLATILE=off
# Where request logs live: memory | sqlite  (default: memory)
#   memory keeps the newest RESIN_REQUEST_LOG_MEMORY_ENTRIES entries in RAM and
#   writes no files; the history is lost on restart.
# RESIN_REQUEST_LOG_STORAGE=memory
# Ring-buffer capacity for memory request-log storage (default: 10000, max 1000000).
# RESIN_REQUEST_LOG_MEMORY_ENTRIES=10000
# Where metric buckets live: memory | sqlite  (default: memory)
#   memory keeps only the last RESIN_METRICS_RETENTION_HOURS hours in RAM; the
#   chart history is lost on restart.
# RESIN_METRICS_STORAGE=memory
# In-memory metric bucket retention window in hours (default: 24).
# RESIN_METRICS_RETENTION_HOURS=24

# --- Disk-write controls (see DESIGN.md §磁盘写入控制) ---
# Probe failure log policy: off | limited | all  (default: limited)
# RESIN_PROBE_FAILURE_LOG=limited
# Max probe tasks enqueued per scan tick; 0 = min(poolSize, max(64, concurrency))
# RESIN_PROBE_SCAN_BATCH=0
# Probe interval seeds (applied only when state.db has no persisted runtime config)
# RESIN_MAX_LATENCY_TEST_INTERVAL=1h
# RESIN_MAX_EGRESS_TEST_INTERVAL=6h
# RESIN_MAX_AUTHORITY_LATENCY_TEST_INTERVAL=3h
# Request log time-based retention in hours; 0 disables (default: 168)
# RESIN_REQUEST_LOG_RETENTION_HOURS=168
